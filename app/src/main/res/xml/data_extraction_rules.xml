<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud-backup and device-transfer rules. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="jm-mobile-g-data.xml" />
        <!-- Startup prefs hold Keystore-encrypted identity/settings; do not restore across devices. -->
        <exclude domain="sharedpref" path="jm-mobile-startup.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="jm-mobile-g-data.xml" />
        <exclude domain="sharedpref" path="jm-mobile-startup.xml" />
    </device-transfer>
</data-extraction-rules>
